# Lifeline on Railway - every variable, by the service that needs it.
# Never set PORT, PREMIUM_API_PORT or SUI_SERVICE_PORT on Railway: each service
# prefers its own variable over the PORT Railway injects, and the proxy would
# then reach nothing.

# ---------------------------------------------------------------- web
# Public URL of this service (Railway domain). Used in links an agent gets.
NEXT_PUBLIC_APP_URL=https://<web>.up.railway.app
LIFELINE_APP_URL=https://<web>.up.railway.app
# Sessions and mandates are signed with this; 32+ random chars.
LIFELINE_SESSION_SECRET=
# Encrypts the agent keys Lifeline holds (web/data volume); 32+ random chars.
LIFELINE_KEYSTORE_SECRET=

# World ID (IDKit sign-in, World ID for Agents approvals)
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ACTION=
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
WORLD_RP_SIGNING_KEY=
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=

# Arc testnet: funding wallet (also treasury/owner), facility, Gateway
ARC_RPC_URL=
PRIVATE_KEY=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_LIFELINE_TREASURY_ADDRESS=
LIFELINE_CREDIT_FACILITY_ADDRESS=
NEXT_PUBLIC_LIFELINE_CREDIT_FACILITY_ADDRESS=
FACILITATOR_URL=
# The Arc seller behind /api/paid/* (and the premium service)
SELLER_PRIVATE_KEY=
SELLER_WALLET_ADDRESS=
# Public URL of the premium service
NEXT_PUBLIC_X402_RESOURCE_BASE=https://<premium>.up.railway.app

# Sui testnet: operator (also the Sui seller)
SUI_NETWORK=testnet
SUI_PRIVATE_KEY=
LIFELINE_TRANCHE_CEILING=
# Public URL of the feed service
SUI_SERVICE_URL=https://<feed>.up.railway.app

# Intercepta
INTERCEPTA_API_KEY=
INTERCEPTA_DEMO_PAYTO=
INTERCEPTA_DEMO_PAYER=

# Stripe (test mode). The webhook is optional: the browser's confirmation books too.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- premium (Arc x402 seller)
ARC_RPC_URL=
FACILITATOR_URL=
SELLER_PRIVATE_KEY=
SELLER_WALLET_ADDRESS=
INTERCEPTA_API_KEY=

# ---------------------------------------------------------------- feed (Sui x402 seller)
SUI_NETWORK=testnet
SUI_PRIVATE_KEY=
