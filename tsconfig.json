{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // Operator scripts reuse the web app's stores, which import through its alias.
    "paths": { "@/*": ["./web/src/*"] }
  },
  // web/ owns its own config; this covers what runs through tsx, which
  // transpiles without checking.
  "include": ["premium-api/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}