{
  "name": "lifeline",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "premium-api",
    "sui"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "build": "npm --workspace=web run build",
    "start": "npm --workspace=web run start",
    "lint": "npm --workspace=web run lint",
    "test": "npm run test:contracts && npm run test:move && npm --workspace=web run test && npm --workspace=sui run test",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p sui/tsconfig.json",
    "premium": "tsx --env-file-if-exists=.env premium-api/server.ts",
    "deposit": "tsx --env-file-if-exists=.env scripts/deposit-gateway.ts",
    "balances": "tsx --env-file-if-exists=.env --tsconfig web/tsconfig.json scripts/check-all-balances.ts",
    "deploy:arc": "cd contracts && forge script script/DeployArc.s.sol --rpc-url arc_testnet --broadcast",
    "e2e:arc": "npm --workspace=web run e2e:arc",
    "test:move": "cd sui/lifeline && sui move test",
    "sui:deploy": "tsx --env-file-if-exists=.env sui/scripts/deploy.ts",
    "sui:service": "tsx --env-file-if-exists=.env sui/service/server.ts",
    "sui:lifecycle": "tsx --env-file-if-exists=.env sui/scripts/lifecycle.ts",
    "e2e:sui": "npm --workspace=web run e2e:sui",
    "sui:reconcile": "tsx --env-file-if-exists=.env --tsconfig web/tsconfig.json sui/scripts/reconcile.ts",
    "e2e:arc-edges": "npm --workspace=web run e2e:arc-edges",
    "e2e:intercepta": "npm --workspace=web run e2e:intercepta",
    "e2e:card": "npm --workspace=web run e2e:card"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@worldcoin/idkit-core": "^4.3.0"
  }
}
