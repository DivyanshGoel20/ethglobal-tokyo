# ==============================================
# Float (ETHGlobal Tokyo) - environment
# ==============================================
# One file for the whole repo: the web app, the premium API, the Sui service
# and every script read this root .env.
#
#   cp .env.example .env
#
# Secrets in section 4 fail *secure* when unset - the app still runs, but
# sessions die on restart and stored agent keys stay unencrypted.

# ----------------------------------------------
# 1. World - one human, one credit line
# ----------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=app_6ad9b6ef952f1c2a9a70a58e05aa9878
NEXT_PUBLIC_WORLD_RP_ID=rp_62d19ed87590c550
NEXT_PUBLIC_WORLD_ACTION=float-credit-line
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
# Signs the RP context. REQUIRED for sign-in. From the World developer portal.
WORLD_RP_SIGNING_KEY=

# ----------------------------------------------
# 2. Arc - the debt ledger (chain 5042002)
# ----------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network

# Owns the facility, signs drawdowns and funds x402 payments through Circle
# Gateway. REQUIRED to move money on Arc.
PRIVATE_KEY=
FLOAT_FUNDING_PRIVATE_KEY=

# FloatCreditFacility for this repo, deployed at block 64024661.
FLOAT_CREDIT_FACILITY_ADDRESS=0xe382723bE95cB5c8801270a03Da17Bf4c27F320f
NEXT_PUBLIC_FLOAT_CREDIT_FACILITY_ADDRESS=0xe382723bE95cB5c8801270a03Da17Bf4c27F320f

# Where a browser repayment is sent, and what the server checks it against.
NEXT_PUBLIC_FLOAT_TREASURY_ADDRESS=0x5233E4253bC38e8CF517c0768dbC8aCC886F32B3

# USDC on Arc is native, exposed as a 6-decimal ERC-20 at this precompile.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway, for batched nanopayment settlement.
FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Who the x402 resources pay. Any Arc address you control.
SELLER_WALLET_ADDRESS=

# ----------------------------------------------
# 3. Sui - the Move rail
# ----------------------------------------------
# localnet (`sui start --with-faucet`), devnet, testnet or mainnet. The
# deployment is read from sui/deployments/<network>.json, written by
# `npm run sui:deploy`; the SUI_* ids below override it when set.
SUI_NETWORK=testnet
# Float's operator: holds the AdminCap, sponsors agents' gas, collects what
# falls due. `suiprivkey...`. sui:deploy generates one if this is empty.
SUI_PRIVATE_KEY=
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# SUI_PACKAGE_ID=
# SUI_FACILITY_ID=
# SUI_ADMIN_CAP_ID=
# SUI_COIN_TYPE=      # e.g. Circle's testnet USDC instead of the demo dollar

# The Sui x402 feed: npm run sui:service
SUI_SERVICE_PORT=4031
SUI_SERVICE_URL=http://localhost:4031
# Who the feed pays. Defaults to the operator.
SUI_SELLER_ADDRESS=

# One parked obligation covers draws up to this, then a new one is parked.
FLOAT_TRANCHE_CEILING=0.5

# ----------------------------------------------
# 4. Float secrets - unset is safe, but degraded
# ----------------------------------------------
# Signs the session cookie. >= 32 chars. Unset: sessions die on restart.
FLOAT_SESSION_SECRET=
# Wraps agent private keys at rest. >= 16 chars. REQUIRED before any deploy.
FLOAT_KEYSTORE_SECRET=

# ----------------------------------------------
# 5. Credit terms
# ----------------------------------------------
FLOAT_DEFAULT_CREDIT_CAP=0.5
FLOAT_TERM_SECONDS=604800        # until a drawdown is due; also the Sui obligation term
FLOAT_MAX_PER_PAYMENT=$5.00

# ----------------------------------------------
# 6. Ports and service URLs
# ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
FLOAT_APP_URL=http://localhost:3000

# Arc x402 resources: npm run premium
PREMIUM_API_PORT=4402
NEXT_PUBLIC_X402_RESOURCE_BASE=http://localhost:4402
